# Either name a file that contains a line NVDA_API_KEY=nvapi-... (the notebook reads only that line)...
NVDA_KEY_FILE=C:/path/to/file/with/NVDA_API_KEY.env
# ...or put the key itself here:
# NVIDIA_NIM_API_KEY=<your_nvapi_key>
# Optional (the AIME25 dataset is public):
# HUGGINGFACE_HUB_TOKEN=<your_hf_token>
